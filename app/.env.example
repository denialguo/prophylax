# Copy to app/.env (git-ignored) and fill in what you need.
# Load it with: set -a; . app/.env; set +a

# Narration needs one of these. Offline tests and benchmarks need neither.
GEMINI_API_KEY=
GROQ_API_KEY=

# Stockfish 18 for analysis and golden tests
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_NODES=1000000

# Your username(s), comma-separated, so history knows which side you played
PROPHYLAX_PLAYER_NAMES=

# Only for generating QUEEN outputs (evals/queen_heldout/run_queen.py)
HF_TOKEN=
